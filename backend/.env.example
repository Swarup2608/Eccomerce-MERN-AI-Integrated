PORT=

MONGO_URI=
REDIS_URL=

# true in production (HTTPS only). Browsers also accept Secure cookies on http://localhost
COOKIE_SECURE=true
# Leave empty for host-only cookies (recommended)
COOKIE_DOMAIN=
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_REFRESH_TTL_DAYS=7
JWT_ACCESS_TTL_MINUTES=15
NODE_ENV=
# Each at least 32 characters and different from each other. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=
ADMIN_URL=

# SMTP credentials from any email provider (SES, Resend, Postmark, Mailtrap, ...).
# Required in production. When SMTP_HOST is empty in development, emails are logged instead of sent
SMTP_HOST=
# 465 uses implicit TLS, any other port uses STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. "My Store <no-reply@example.com>"
EMAIL_FROM=

# Twilio credentials for phone verification codes.
# Required in production. When empty in development, codes are logged instead of sent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in E.164 format, e.g. +14155550123
TWILIO_FROM_NUMBER=

# Number of reverse proxies (load balancer, CDN) in front of the API. 0 when clients connect directly
TRUST_PROXY_HOPS=0
