PORT=

MONGO_URI=
REDIS_URL=

# true in production (HTTPS only). Browsers also accept Secure cookies on http://localhost
COOKIE_SECURE=true
# Leave empty for host-only cookies (recommended)
COOKIE_DOMAIN=
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_REFRESH_TTL_DAYS=7
JWT_ACCESS_TTL_MINUTES=15
NODE_ENV=
# Each at least 32 characters and different from each other. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=
ADMIN_URL=
